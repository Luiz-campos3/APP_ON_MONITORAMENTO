{
  "expo": {
    "name": "OnWay Cliente",
    "slug": "onway-cliente",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/logo-mark.png",
    "scheme": "onwayclient",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/logo-mark.png",
      "bundleIdentifier": "br.com.onway.cliente",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07100D",
        "foregroundImage": "./assets/brand/logo-mark.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.onway.cliente"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-mark-splash-gray.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8b268f4-3832-49a0-949f-039169f4fd49"
      }
    },
    "owner": "guilherme_campos_22"
  }
}
